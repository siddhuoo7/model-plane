# Model Plane — environment variables template
# Copy to .env and fill in real values. Never commit .env to git.

MODEL_PLANE_ENV=development
MODEL_PLANE_HOST=0.0.0.0
MODEL_PLANE_PORT=8081
MODEL_PLANE_LOG_LEVEL=info
MODEL_PLANE_WORKERS=1

# API key auth (comma-separated; empty = no auth, development only)
MODEL_PLANE_API_KEYS=

# Default model alias (must match a name in config/models.yaml)
MODEL_PLANE_DEFAULT_MODEL=local-medium

# Routing mode: fixed | auto_router | custom_plugin | hybrid
MODEL_PLANE_ROUTING_MODE=custom_plugin

# ML routing
MODEL_PLANE_ML_ROUTING_ENABLED=false
MODEL_PLANE_ML_CONFIDENCE_THRESHOLD=0.70
MODEL_PLANE_ML_MODEL_PATH=models/router_ml.joblib

# Session cache (optional Redis)
# MODEL_PLANE_REDIS_URL=redis://localhost:6379/0
MODEL_PLANE_CACHE_TTL_SECONDS=3600

# Compression
MODEL_PLANE_COMPRESSION_ENABLED=true
MODEL_PLANE_COMPRESSION_TOKEN_THRESHOLD=6000

# Observability
MODEL_PLANE_METRICS_ENABLED=true
MODEL_PLANE_METRICS_PATH=/metrics

# Provider credentials (set one or more)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
WATSONX_API_KEY=McTcXC<>
WATSONX_PROJECT_ID=4a3e8bae-8<>
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Local model endpoints (used when api_base is set in models.yaml)
LOCAL_SMALL_API_BASE=http://localhost:8001/v1
LOCAL_SMALL_API_KEY=none
LOCAL_MEDIUM_API_BASE=http://localhost:8002/v1
LOCAL_MEDIUM_API_KEY=none
LOCAL_CODER_API_BASE=http://localhost:8003/v1
LOCAL_CODER_API_KEY=none
LOCAL_REASONING_API_BASE=http://localhost:8004/v1
LOCAL_REASONING_API_KEY=none
