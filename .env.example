# Model Plane — environment variables template
# Copy to .env and fill in real values. Never commit .env to git.

MODEL_PLANE_ENV=development
MODEL_PLANE_HOST=0.0.0.0
MODEL_PLANE_PORT=8081
MODEL_PLANE_LOG_LEVEL=info
MODEL_PLANE_WORKERS=1

# API key auth (comma-separated; empty = no auth, development only)
MODEL_PLANE_API_KEYS=

# Default model alias (must match a name in config/models.yaml)
MODEL_PLANE_DEFAULT_MODEL=watsonx-granite-small

# Routing mode: fixed | auto_router | custom_plugin | hybrid
MODEL_PLANE_ROUTING_MODE=custom_plugin

# Feature flags
# When enabled, RequestFeatures.as_vector() returns 15 floats (adds task_type_tier_signal).
# Keep false until the ML model is retrained with 15-dim data (Phase 2).
MODEL_PLANE_FEATURES_15_DIM_ENABLED=false

# ML routing
MODEL_PLANE_ML_ROUTING_ENABLED=false
MODEL_PLANE_ML_CONFIDENCE_THRESHOLD=0.70
# Tier model (Sub-Task 2.2): model predicts ComplexityTier instead of deployment names.
# Retrain: python -m model_plane.ml.trainer --label complexity_tier --output models/router_ml_tier_v1.joblib
MODEL_PLANE_ML_MODEL_PATH=models/router_ml_tier_v1.joblib
# "tier" (default) — model outputs ComplexityTier; "deployment" — legacy rollback
MODEL_PLANE_ML_OUTPUT_MODE=tier

# Classifier backend selector
# regex  — pure regex chain (default, zero deps, ~0 ms)
# mbert  — regex + BERT NLI: overrides task_type, re-derives tier
#          Requires: pip install 'model-plane[bert]'
# laya   — regex + Laya:  overrides task_type AND complexity_tier in one call
#          Requires: pip install laya
MODEL_PLANE_CLASSIFIER_MODEL=regex
MODEL_PLANE_CLASSIFIER_MIN_CONFIDENCE=0.60

# BERT classifier — DEPRECATED: use MODEL_PLANE_CLASSIFIER_MODEL=mbert instead.
# Setting BERT_CLASSIFIER_ENABLED=true is treated as CLASSIFIER_MODEL=mbert
# when CLASSIFIER_MODEL is still "regex" (backward-compat alias).
# MODEL_PLANE_BERT_CLASSIFIER_ENABLED=false
# llm-semantic-router/mmbert32k-intent-classifier-merged — 149M ModernBERT, <83ms on CPU, downloads once from HuggingFace
# MODEL_PLANE_BERT_CLASSIFIER_MODEL=llm-semantic-router/mmbert32k-intent-classifier-merged

# Session cache (optional Redis)
# MODEL_PLANE_REDIS_URL=redis://localhost:6379/0
MODEL_PLANE_CACHE_TTL_SECONDS=3600

# Compression
MODEL_PLANE_COMPRESSION_ENABLED=true
MODEL_PLANE_COMPRESSION_TOKEN_THRESHOLD=6000

# Observability
MODEL_PLANE_METRICS_ENABLED=true
MODEL_PLANE_METRICS_PATH=/metrics

# Security & Secret Settings
MODEL_PLANE_JWT_SECRET=replace_with_a_secure_random_string_32_chars_min
MODEL_PLANE_ADMIN_API_KEY=

# Provider credentials (set one or more)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Local / self-hosted vLLM endpoint
LOCAL_VLLM_API_BASE=https://your-vllm-cluster.example.com/v1
LOCAL_VLLM_API_KEY=
REQUESTS_CA_BUNDLE=/absolute/path/to/ca-bundle.crt
# SSL_CERT_FILE — DO NOT SET: httpx interprets this as a client-cert chain
# (load_cert_chain), not a CA bundle, causing SSL PEM errors on every call.
# Use REQUESTS_CA_BUNDLE for Python/httpx CA trust and NODE_EXTRA_CA_CERTS for Node.
NODE_EXTRA_CA_CERTS=/absolute/path/to/ca-bundle.crt

# AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION_NAME=us-east-1
# AWS_ROLE_NAME=arn:aws:iam::123456789012:role/BedrockRole  # optional assume-role

# Azure OpenAI
# AZURE_API_KEY=
# AZURE_API_BASE=https://YOUR_RESOURCE.openai.azure.com
# AZURE_API_VERSION=2024-02-01

# Google Vertex AI
# VERTEXAI_PROJECT=my-gcp-project-id
# VERTEXAI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Cohere
# COHERE_API_KEY=

# Mistral
# MISTRAL_API_KEY=
