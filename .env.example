# Quick Start / Minimal Configuration

# Server Port
MODEL_PLANE_PORT=8081

# Routing Engine Mode: fixed | auto_router | custom_plugin | hybrid
MODEL_PLANE_ROUTING_MODE=custom_plugin

# Classifier Mode: regex | ml_task | mbert | laya
MODEL_PLANE_CLASSIFIER_MODEL=regex

# Optional: Admin UI API Key (leave empty for open local dev mode)
ADMIN_API_KEY=

# Optional: Client API Keys (comma-separated for /v1/* client auth)
# MODEL_PLANE_API_KEYS=sk-test-key-1,sk-test-key-2

# -----------------------------------------------------------------------------
# Provider Credentials
# TIP: You can also configure credentials directly from the Admin UI at
# http://localhost:8081/admin/settings under Provider Management.
# -----------------------------------------------------------------------------

# watsonx
# WATSONX_APIKEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1

# Azure OpenAI
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=2024-02-01

# Cohere / Mistral / Vertex
# COHERE_API_KEY=
# MISTRAL_API_KEY=
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1
